{
  "name": "veritas-face",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "devDependencies": {
    "js-yaml": "4.3.2",
    "next": "16.0.0"
  },
  "scripts": {
    "check:manifest": "node --eval \"JSON.parse(require('node:fs').readFileSync('package.json', 'utf8')); JSON.parse(require('node:fs').readFileSync('apps/web/package.json', 'utf8')); console.log('package manifests valid')\"",
    "check:compose": "node scripts/validate-compose.mjs",
    "test:api": "python3 -m unittest discover -s services/api/tests",
    "test:training": "python3 -m unittest discover -s training/tests",
    "check:training": "python3 training/validate_manifests.py",
    "test:web": "npm run test --workspace=@veritas-face/web",
    "lint:web": "npm run lint --workspace=@veritas-face/web",
    "build:web": "npm run build --workspace=@veritas-face/web",
    "check:inference": "sh services/inference/run-checks.sh",
    "check": "npm run check:manifest && npm run check:compose && npm run test:api && npm run test:training && npm run check:training && npm run check:inference && npm run test:web && npm run lint:web && npm run build:web"
  }
}
