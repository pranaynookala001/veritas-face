# Never place real secrets in this file.
VERITAS_ENV=development
UPLOAD_RETENTION_MINUTES=30
MAX_UPLOAD_BYTES=10485760
API_PORT=8000
INFERENCE_PORT=8080
# Compose publishes only the web and API ports. Keep internal services private.
WEB_PORT=3000
VERITAS_FACE_WEB_ORIGINS=http://localhost:3000
# Optional local C++ inference endpoint; detector evidence is unavailable when unset.
VERITAS_FACE_INFERENCE_URL=http://127.0.0.1:8080
# Optional private ONNX model mounted read-only at /models by Docker Compose.
# Leave blank to keep the inference service live but deliberately model-unavailable.
# VERITAS_INFERENCE_MODEL=/models/portrait-classifier.onnx
# VERITAS_INFERENCE_MODEL_VERSION=release-YYYY.MM.N
# VERITAS_INFERENCE_MODEL_ID=synthetic-portrait-classifier
# Optional local JSON calibration artifact for the exact configured detector release.
# Without it, detector evidence cannot determine a verdict.
# VERITAS_FACE_CALIBRATION_PATH=/private/path/heldout-calibration.json
# In Docker Compose, mount a private file under the ignored ./calibration directory.
# VERITAS_FACE_CALIBRATION_PATH=/calibration/release-YYYY.MM.N.json
VERITAS_POSTGRES_PASSWORD=veritas-local-development-only
VERITAS_MINIO_ROOT_USER=veritas-local
VERITAS_MINIO_ROOT_PASSWORD=veritas-local-development-only
DATABASE_URL=postgresql://veritas:veritas-local-development-only@postgres:5432/veritas
REDIS_URL=redis://redis:6379/0
