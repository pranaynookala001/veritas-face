# Never place real secrets in this file.
VERITAS_ENV=development
UPLOAD_RETENTION_MINUTES=30
MAX_UPLOAD_BYTES=10485760
API_PORT=8000
INFERENCE_PORT=8080
# Optional local C++ inference endpoint; detector evidence is unavailable when unset.
VERITAS_FACE_INFERENCE_URL=http://127.0.0.1:8080
# Optional local JSON calibration artifact for the exact configured detector release.
# Without it, detector evidence cannot determine a verdict.
# VERITAS_FACE_CALIBRATION_PATH=/private/path/heldout-calibration.json
DATABASE_URL=postgresql://veritas:veritas@postgres:5432/veritas
REDIS_URL=redis://redis:6379/0
